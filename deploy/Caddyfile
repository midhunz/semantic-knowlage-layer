# SL_DOMAIN=semantic.example.com  -> automatic HTTPS (Let's Encrypt); ports 80 and 443 must reach this host
# SL_DOMAIN=localhost             -> HTTPS with Caddy's local certificate (testing)
# SL_DOMAIN=:80                   -> plain HTTP only (testing behind another TLS terminator)
{$SL_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy app:8000 {
		health_uri /ready
		health_interval 10s
	}
	header -Server
	log {
		output stdout
		format json
	}
}
