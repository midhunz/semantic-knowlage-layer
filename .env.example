# Docker deployment (docker-compose.prod.yml).  cp .env.example .env  and fill in the blanks. Never commit .env.
# Use URL-safe secrets (they are embedded in a connection URL):  openssl rand -hex 24

# --- database -------------------------------------------------------------------------------------
POSTGRES_USER=semantic
POSTGRES_PASSWORD=
POSTGRES_DB=semantic_layer

# --- public address -------------------------------------------------------------------------------
# ":80" = plain HTTP (local / LAN). A real domain gives automatic HTTPS.
SL_DOMAIN=:80
SL_HTTP_PORT=80
SL_HTTPS_PORT=443

# --- first administrator --------------------------------------------------------------------------
# Option A (recommended): leave blank and run once after the first start:
#   docker compose -f docker-compose.prod.yml exec app python -m app.cli create-admin --email you@example.com
# Option B: set both, start, sign in, then DELETE the password line and restart.
SL_BOOTSTRAP_ADMIN_EMAIL=
SL_BOOTSTRAP_ADMIN_PASSWORD=

# --- tuning ---------------------------------------------------------------------------------------
SL_COOKIE_SECURE=auto          # auto | always | never ("never" is refused in production)
WEB_CONCURRENCY=2              # worker processes
SL_ENABLE_DOCS=false           # true exposes /docs and /openapi.json
# SL_CORS_ORIGINS=             # leave empty: the UI is served by the app itself (same origin)
# SL_VERSION=latest            # image tag
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# --- Trino source (set in the UI under Sources, not here) -----------------------------------------
# From inside the app container use host.docker.internal (Docker Desktop) or the PC's IP, port 8080, catalog lake.
